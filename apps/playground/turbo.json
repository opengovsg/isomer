{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@opengovsg/isomer-components#build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["@opengovsg/isomer-components#build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["public/0.1.0.json"]
    }
  }
}
