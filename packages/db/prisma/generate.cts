import * as fs from "fs/promises"
import * as path from "path"

const TYPE_FOLDER = "../src/generated"
const TYPE_FILE = "generatedTypes.ts"
const GENERATED_FILE = "selectableTypes.ts"

const extractTableTypes = (source: string): string[] => {
  const dbBody =
    source.match(/export type DB\s*=\s*\{([\s\S]*?)\};/)?.[1] ??
    source.match(/export interface DB\s*\{([\s\S]*?)\};?/)?.[1]

  if (!dbBody) {
    throw new Error("Could not find DB type definition in generatedTypes.ts")
  }

  const tables: string[] = []
  for (const line of dbBody.split("\n")) {
    const tableName = line.match(/^\s*(\w+)\s*:/)?.[1]
    if (tableName) {
      tables.push(tableName)
    }
  }

  if (tables.length === 0) {
    throw new Error("No tables found in DB type definition")
  }

  return tables
}

const buildSelectableTypes = (tableTypes: string[]): string => {
  const exports = tableTypes
    .map((table) => `export type ${table} = Selectable<T.${table}>`)
    .join("\n")

  return [
    "// THIS FILE IS AUTOMATICALLY GENERATED. DO NOT EDIT IT MANUALLY.",
    'import { type Selectable } from "kysely"',
    "",
    'import type * as T from "./generatedTypes"',
    exports,
    "",
  ].join("\n")
}

export const generate = async () => {
  const inputPath = path.join(__dirname, TYPE_FOLDER, TYPE_FILE)
  const source = await fs.readFile(inputPath, "utf-8")
  const tableTypes = extractTableTypes(source)
  const outputPath = path.join(__dirname, TYPE_FOLDER, GENERATED_FILE)
  await fs.writeFile(outputPath, buildSelectableTypes(tableTypes))
}

generate().catch((error) => {
  console.error(error)
  process.exit(1)
})
