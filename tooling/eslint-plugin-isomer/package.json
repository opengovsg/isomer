{
  "name": "eslint-plugin-isomer",
  "version": "0.1.0",
  "private": true,
  "description": "Isomer-specific ESLint rules (loaded via Oxlint jsPlugins)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt --check . --ignore-path ../../.gitignore",
    "format:fix": "oxfmt --write . --ignore-path ../../.gitignore",
    "lint": "oxlint src",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsgo"
  },
  "devDependencies": {
    "@isomer/tsconfig": "workspace:*",
    "@types/eslint": "catalog:",
    "@types/estree": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
