{
  "name": "@isomer/astro-migration-experiment",
  "version": "0.0.0",
  "private": true,
  "description": "Measurement + parity harness behind RFC.md: compares apps/template (Next) with apps/template-astro",
  "type": "module",
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "fixture": "node scripts/fixture.mjs",
    "fixture:make": "tsx scripts/make-fixture.ts",
    "measure": "node scripts/measure.mjs",
    "test:hydration": "node scripts/hydration-check.mjs",
    "test:parity": "playwright test --project=next --update-snapshots && playwright test --project=astro",
    "variants": "node scripts/variants.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:playwright",
    "playwright": "catalog:playwright",
    "tsx": "catalog:"
  }
}
