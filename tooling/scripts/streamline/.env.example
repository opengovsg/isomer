# This is the AWS_PROFILE used for the Isomer Classic AWS account
AWS_CLASSIC_PROFILE=isomer-classic

# This is the AWS_PROFILE used for the Isomer Next Production AWS account
AWS_NEXT_PROFILE=isomer-production

# This is the SearchSG authentication information
SEARCHSG_USERNAME=
SEARCHSG_PASSWORD=

# This is the UptimeRobot API key for Project Streamline
UPTIMEROBOT_API_KEY=

# Studio production RDS (IAM auth). A token is generated at connect time
# against the real RDS host/port. TCP goes through `npm run db:connect`
# (localhost tunnel), same as TablePlus.
ISOMER_STUDIO_DB_HOST=isomer-next-infra-prod-rds-cluster.cluster-xxxx.ap-southeast-1.rds.amazonaws.com # pls update this
ISOMER_STUDIO_DB_PORT=5432
ISOMER_STUDIO_DB_USER=username_rw # pls update this
ISOMER_STUDIO_DB_NAME=isomer_next_infra_prod
ISOMER_STUDIO_DB_REGION=ap-southeast-1
ISOMER_STUDIO_DB_TUNNEL_HOST=127.0.0.1
ISOMER_STUDIO_DB_TUNNEL_PORT=5433

# This is the path to the sites.production.csv file inside isomer-next-infra
SITES_CSV_PATH=

# This is the GitHub token with repo access to isomerpages/isomer-indirection repo
GITHUB_TOKEN=

# This is the S3 bucket URI for Isomer Next Production assets
S3_BUCKET_URI=s3://

# This is the API key for foundry.pair.gov.sg
PAIR_FOUNDRY_API_KEY=
