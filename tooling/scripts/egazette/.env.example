# Public gazette PDF hostname, without https:// or a trailing slash.
# Use the hostname for the environment selected in the CLI.
S3_GAZETTE_DOMAIN_NAME=gazette-assets.example.gov.sg

# Remote database: use the same values as export-import.
# Copy this block with UAT_ or PROD_ prefixes for those environments.
# DB_HOST/DB_PORT identify RDS for IAM signing; DB_TUNNEL_* identify the open tunnel.
STAGING_DB_HOST=your-database.ap-southeast-1.rds.amazonaws.com
STAGING_DB_PORT=5432
STAGING_DB_USERNAME=your_iam_database_user
STAGING_DB_NAME=isomer
STAGING_DB_REGION=ap-southeast-1
STAGING_AWS_PROFILE=your-staging-sso-profile
STAGING_DB_TUNNEL_HOST=localhost
STAGING_DB_TUNNEL_PORT=5433

# Local development only: password authentication, no AWS profile or tunnel.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USERNAME=postgres
LOCAL_DB_NAME=isomer
LOCAL_DB_PASSWORD=
