# Database connection string for Isomer Studio
DATABASE_URL=

# Algolia settings — required by "Remove/Repair gazette search records"
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# Gazette S3 settings — required by "Repair gazette search records" only
# (Remove only needs the Algolia + DB settings above; it never reads S3)
S3_GAZETTE_BUCKET_NAME=
S3_GAZETTE_DOMAIN_NAME=
