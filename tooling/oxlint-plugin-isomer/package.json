{
  "name": "oxlint-plugin-isomer",
  "version": "0.1.0",
  "private": true,
  "description": "Isomer-specific Oxlint rules",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt --check . --ignore-path ../../.gitignore",
    "format:fix": "oxfmt --write . --ignore-path ../../.gitignore",
    "lint": "oxlint src",
    "prepare": "pnpm run build",
    "test": "tsx src/rules/one-hook-per-file.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
