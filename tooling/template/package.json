{
  "name": "isomer-base-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:local": "rm -rf .next && curl https://raw.githubusercontent.com/opengovsg/isomer/main/tooling/build/scripts/preBuild.sh | bash && pnpm run build",
    "build:template": "pnpm run generate:layout-routes && next build --webpack",
    "clean": "git clean -xdf .next .turbo node_modules out",
    "dev": "PORT=3001 next dev --webpack",
    "format": "oxfmt --check . --ignore-path ../../.gitignore",
    "format:fix": "oxfmt --write . --ignore-path ../../.gitignore",
    "generate:layout-routes": "node ./scripts/generate-layout-routes.mjs",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "start": "next start",
    "test-ci:e2e": "vitest run --project e2e",
    "test-ci:unit": "vitest run --project unit",
    "test:e2e": "pnpm exec turbo test-ci:e2e --filter=isomer-base-template --env-mode=loose",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@isomer/validators": "workspace:*",
    "@opengovsg/isomer-components": "workspace:*",
    "isomorphic-dompurify": "catalog:",
    "jsdom": "catalog:",
    "next": "catalog:",
    "postcss": "catalog:",
    "postcss-preset-env": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@isomer/oxlint-config": "workspace:*",
    "@isomer/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@typescript/native-preview": "catalog:",
    "vitest": "catalog:vitest"
  }
}
